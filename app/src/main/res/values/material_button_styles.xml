<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme overlay specifically for MaterialButton compatibility -->
    <style name="ThemeOverlay.Konvert.MaterialButton" parent="ThemeOverlay.MaterialComponents">
        <!-- Material Components color attributes required for MaterialButton -->
        <item name="colorPrimary">@color/ripple_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/clean_background</item>
        <item name="colorOnSurface">@color/clean_text_primary</item>
        <item name="colorOutline">@color/ripple_primary</item>
    </style>

    <!-- Custom MaterialButton style that works with AppCompat theme -->
    <style name="Widget.Konvert.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/ripple_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Custom MaterialButton outlined style -->
    <style name="Widget.Konvert.MaterialButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/ripple_primary</item>
        <item name="strokeColor">@color/ripple_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
</resources>
