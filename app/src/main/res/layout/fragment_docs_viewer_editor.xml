<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/clean_background">

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Documents RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/docs_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:scrollbarStyle="outsideOverlay" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/emptyStateLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_document_outline"
                android:layout_marginBottom="24dp"
                android:alpha="0.4"
                android:tint="@color/clean_text_tertiary"
                android:contentDescription="No documents illustration" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No documents found"
                android:textSize="20sp"
                android:textColor="@color/clean_text_primary"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documents you convert will appear here"
                android:textSize="16sp"
                android:textColor="@color/clean_text_secondary"
                android:fontFamily="sans-serif"
                android:gravity="center" />

        </LinearLayout>

        <!-- Loading State View -->
        <LinearLayout
            android:id="@+id/loadingStateLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="16dp"
                style="?android:attr/progressBarStyle"
                android:indeterminateTint="@color/ripple_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scanning documents..."
                android:textSize="16sp"
                android:textColor="@color/clean_text_secondary"
                android:fontFamily="sans-serif" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
