<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_custom_dialog"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Location"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <!-- Current Location -->
    <TextView
        android:id="@+id/dialog_current_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current: Documents/Konvert"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="16dp" />

    <!-- Location Options -->
    <RadioGroup
        android:id="@+id/radio_group_locations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/radio_documents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Documents/Konvert"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif"
            android:paddingVertical="8dp"
            android:buttonTint="@color/clean_accent" />

        <RadioButton
            android:id="@+id/radio_downloads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downloads"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif"
            android:paddingVertical="8dp"
            android:buttonTint="@color/clean_accent" />

        <RadioButton
            android:id="@+id/radio_pictures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pictures/Konvert"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif"
            android:paddingVertical="8dp"
            android:buttonTint="@color/clean_accent" />

        <RadioButton
            android:id="@+id/radio_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Custom Location..."
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif"
            android:paddingVertical="8dp"
            android:buttonTint="@color/clean_accent" />

    </RadioGroup>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/dialog_button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_dialog_button_secondary"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/dialog_button_positive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update"
            android:textSize="16sp"
            android:textColor="@color/text_on_primary"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_dialog_button_primary"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
