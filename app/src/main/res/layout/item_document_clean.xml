<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/clean_surface"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- File Type Icon -->
        <ImageView
            android:id="@+id/file_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_document_outline"
            android:tint="@color/ripple_primary"
            android:contentDescription="Document type icon"
            tools:src="@drawable/ic_document_outline" />

        <!-- File Info Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- File Name -->
            <TextView
                android:id="@+id/file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/clean_text_primary"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="middle"
                tools:text="Sample Document.pdf" />

            <!-- Last Modified Date -->
            <TextView
                android:id="@+id/last_modified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@color/clean_text_secondary"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                tools:text="Modified 2 hours ago" />

        </LinearLayout>

        <!-- File Size (Optional) -->
        <TextView
            android:id="@+id/file_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="12sp"
            android:textColor="@color/clean_text_tertiary"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:visibility="gone"
            tools:text="2.4 MB"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
